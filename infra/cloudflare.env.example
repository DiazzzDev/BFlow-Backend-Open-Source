# Copy to infra/cloudflare.env and fill in. Never commit the real file.
#
# Used by bootstrap/15-dns-sync.sh to store these in Secrets Manager so
# the dns-sync Lambda can update the A record whenever the ECS task's
# public IP changes — see infra/dns-sync/main.go.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DNS_RECORD_ID=
CLOUDFLARE_DNS_RECORD_NAME=api.bflow-studio.com
